#!/usr/bin/env bash
# Blocks commits/pushes that would publish credentials or private config.
#   check-secrets --staged          what's about to be committed (pre-commit)
#   check-secrets <rev-list args>   every commit in a range, e.g. origin/main..main (pre-push)
#
# Three checks on every added line / file:
#   1. forbidden files: config.yaml (+ backups), data/, .env, private keys
#   2. the real passwords from your live config.yaml (read now, never stored or printed)
#   3. things that look like credentials: "password: x" in config-type files, "scheme://user:pass@" anywhere
# Bypass for a false positive (think twice): git commit/push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

FORBIDDEN='(^|/)config\.yaml$|(^|/)config\.yaml\.|\.bak$|^data/|(^|/)\.env(\..*)?$|\.pem$|\.key$|(^|/)id_(rsa|ed25519|ecdsa)$'
PLACEHOLDERS='^(user:pass|user:password|username:password|USER:PASS|\*+:\*+)$'

secrets=$(mktemp); chmod 600 "$secrets"; trap 'rm -f "$secrets"' EXIT
# Real secrets from the live config: password values and user:pass inside URLs (4+ chars to avoid noise).
for f in config.yaml config.yaml.bak; do
  [ -f "$f" ] || continue
  sed -nE 's/^[[:space:]]*-?[[:space:]]*password:[[:space:]]*["'"'"']?([^"'"'"'#]*[^"'"'"'#[:space:]])["'"'"']?.*$/\1/p' "$f"
  { grep -oE '[a-z0-9+]+://[^/[:space:]:@"'"'"']+:[^@[:space:]/"'"'"']+@' "$f" || true; } | sed -E 's#^[^:]+://[^:]+:(.*)@$#\1#'
done | awk 'length($0) >= 4' | sort -u > "$secrets"

scan_diff() {   # stdin: unified diff; $1: label. Prints problems, exit 1 if any.
  PH="$PLACEHOLDERS" awk -v label="$1" -v secfile="$secrets" '
    BEGIN { ph = ENVIRON["PH"]; while ((getline s < secfile) > 0) sec[++n] = s; bad = 0 }
    /^\+\+\+ / { path = substr($0, 5); sub(/^b\//, "", path); cfgfile = (path ~ /\.(ya?ml|env|ini|conf|cfg|json|toml)$/ || path ~ /(^|\/)\.env/); next }
    /^\+/ {
      line = substr($0, 2)
      if (path == ".githooks/check-secrets") next
      for (i = 1; i <= n; i++) if (index(line, sec[i])) { printf "  %s  %s: contains one of your real passwords\n", label, path; bad = 1 }
      if (cfgfile && match(line, /^[[:space:]]*-?[[:space:]]*password:[[:space:]]*[^[:space:]#]/)) {
        v = line; sub(/^[^:]*password:[[:space:]]*/, "", v); gsub(/["'\'']|[[:space:]]*#.*$/, "", v)
        if (v !~ /^(change-me|changeme|null|~|<.*>|\$\{.*\}|\*+)$/ && v != "") { printf "  %s  %s: password: <hidden>\n", label, path; bad = 1 }
      }
      s = line
      while (match(s, /[a-z0-9+]+:\/\/[^\/[:space:]:@"'\''`]+:[^@[:space:]\/"'\''`]+@/)) {
        cred = substr(s, RSTART, RLENGTH); sub(/^[^:]+:\/\//, "", cred); sub(/@$/, "", cred)
        if (cred !~ ph && cred !~ /[$\{\}]/) { printf "  %s  %s: URL with an embedded login (user:<hidden>@)\n", label, path; bad = 1 }
        s = substr(s, RSTART + RLENGTH)
      }
    }
    END { exit bad }'
}

problems=0
check_names() {  # stdin: file names; $1: label
  local bad; bad=$(grep -E "$FORBIDDEN" || true)
  if [ -n "$bad" ]; then printf '%s\n' "$bad" | sed "s/^/  $1  forbidden file: /"; problems=1; fi
}

if [ "${1:-}" = "--staged" ]; then
  git diff --cached --name-only --diff-filter=ACMR | check_names "staged"
  git diff --cached -U0 --no-color --diff-filter=ACMR | scan_diff "staged" || problems=1
else
  for c in $(git rev-list "$@"); do
    short=$(git rev-parse --short "$c")
    git diff-tree -r --root --no-commit-id --name-only --diff-filter=ACMR "$c" | check_names "$short"
    git show --format= -U0 --no-color --diff-filter=ACMR "$c" | scan_diff "$short" || problems=1
  done
fi

if [ "$problems" != 0 ]; then
  echo "✋ Blocked: the above would publish credentials or private config." >&2
  echo "   Remove them (git rm --cached <file>, or amend/rebase the commit) and try again." >&2
  exit 1
fi
