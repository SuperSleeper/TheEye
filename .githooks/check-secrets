#!/usr/bin/env bash
# Blocks commits/pushes that would publish credentials, private config or personal details.
#   check-secrets --staged          what's about to be committed (pre-commit)
#   check-secrets --message FILE    a commit message (commit-msg)
#   check-secrets <rev-list args>   every commit in a range, files and messages (pre-push)
#
# Checks on every added line / file:
#   1. forbidden files: config.yaml (+ backups), auth.json, data/, .env, private keys
#   2. your real passwords, read from the live config.yaml at check time (never stored or printed)
#   3. your personal details: camera IPs/hostnames and non-generic camera names from config.yaml,
#      your git email, your home folder path
#   4. look-alikes: "password: x" in config-type files, "scheme://user:pass@", any real-looking email
# Use sample data instead: 192.168.1.50, user:pass, change-me, someone@example.com, "Driveway".
# Bypass for a false positive (think twice): git commit/push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

FORBIDDEN='(^|/)config\.yaml$|(^|/)auth\.json$|(^|/)config\.yaml\.|\.bak$|^data/|(^|/)\.env(\..*)?$|\.pem$|\.key$|(^|/)id_(rsa|ed25519|ecdsa)$'
PLACEHOLDERS='^(user:pass|user:password|username:password|USER:PASS|\*+:\*+)$'
# Camera names made only of these words are generic enough to appear in docs and samples.
GENERIC='^(front|back|side|rear|left|right|north|south|east|west|main|upper|lower|inside|outside|indoor|outdoor|driveway|yard|porch|door|garage|gate|garden|patio|deck|hall|hallway|fronthall|entrance|entry|kitchen|living|room|office|basement|attic|shed|street|road|alley|parking|lot|lobby|stairs|camera|cam|doorbell|pool|lawn|path|walkway|[0-9]+)$'

tmp=$(mktemp -d); chmod 700 "$tmp"; trap 'rm -rf "$tmp"' EXIT
secrets=$tmp/secrets personal=$tmp/personal
q='["'"'"']'
# Configs to learn real passwords/details from: any left in the repo, plus each install folder run.sh has used.
CONFIGS=(config.yaml config.yaml.bak)
while IFS= read -r d; do [ -n "$d" ] && CONFIGS+=("$d/config.yaml" "$d/config.yaml.bak"); done \
  < <(git config --get-all theeye.install 2>/dev/null || true; echo "${THEEYE_HOME:-}"; echo "$HOME/TheEye-install")
for f in "${CONFIGS[@]}"; do                  # real secrets: password values and user:pass inside URLs
  [ -f "$f" ] || continue
  sed -nE "s/^[[:space:]]*-?[[:space:]]*password:[[:space:]]*$q?([^\"'#]*[^\"'#[:space:]])$q?.*\$/\\1/p" "$f"
  { grep -oE '[a-z0-9+]+://[^/[:space:]:@"'"'"']+:[^@[:space:]/"'"'"']+@' "$f" || true; } | sed -E 's#^[^:]+://[^:]+:(.*)@$#\1#'
done | awk 'length($0) >= 4' | sort -u > "$secrets"
{                                             # personal details, as "kind<TAB>value"
  for f in "${CONFIGS[@]}"; do
    [ -f "$f" ] || continue
    sed -nE "s/^[[:space:]]*-?[[:space:]]*host:[[:space:]]*$q?([^\"'#[:space:]]+).*\$/camera address\t\\1/p" "$f"
    { grep -oE '[a-z0-9+]+://([^/@[:space:]]+@)?[^/:@[:space:]"'"'"']+' "$f" || true; } | sed -E 's#^[^:]+://([^@]*@)?#camera address\t#'
    awk '/^[^[:space:]#-]/ { incam = ($0 ~ /^cameras:/) } incam' "$f" |      # camera names only, not login names
      sed -nE "s/^[[:space:]]*-?[[:space:]]*name:[[:space:]]*$q?([^\"'#]*[^\"'#[:space:]])$q?.*\$/\\1/p" |
      while IFS= read -r n; do
        generic=1
        for w in $(printf '%s' "$n" | tr '[:upper:]_-' '[:lower:]  '); do [[ "$w" =~ $GENERIC ]] || generic=0; done
        [ "$generic" = 1 ] || printf 'camera name\t%s\n' "$n"
      done
  done
  e=$(git config user.email || true); [ -n "$e" ] && printf 'your email\t%s\n' "$e"
  [ -n "${HOME:-}" ] && [ "$HOME" != / ] && printf 'your home folder path\t%s\n' "$HOME"
} | awk -F'\t' 'length($2) >= 4 && $2 !~ /^(localhost|127\.0\.0\.1|0\.0\.0\.0)$/' | sort -u > "$personal"

scan_diff() {   # stdin: unified diff (-U0); $1: label. Prints problems (never the matched value); exit 1 if any.
  PH="$PLACEHOLDERS" awk -v label="$1" -v secfile="$secrets" -v perfile="$personal" '
    BEGIN {
      ph = ENVIRON["PH"]; bad = 0
      while ((getline s < secfile) > 0) sec[++n] = s
      while ((getline s < perfile) > 0) { split(s, a, "\t"); pk[++m] = a[1]; pv[m] = tolower(a[2]) }
    }
    function report(msg) { printf "  %s  %s:%s  %s\n", label, path, ln, msg; bad = 1 }
    /^\+\+\+ / { path = substr($0, 5); sub(/^b\//, "", path); cfgfile = (path ~ /\.(ya?ml|env|ini|conf|cfg|json|toml)$/ || path ~ /(^|\/)\.env/); next }
    /^@@/ { split($3, h, ","); ln = substr(h[1], 2) - 1; next }
    /^\+/ {
      ln++; line = substr($0, 2); low = tolower(line)
      if (path == ".githooks/check-secrets") next
      for (i = 1; i <= n; i++) if (index(line, sec[i])) report("one of your real passwords")
      for (i = 1; i <= m; i++) {
        p = index(low, pv[i]); if (!p) continue
        if (pk[i] == "camera address") {            # whole address only: 172.17.0.7 must not match 172.17.0.73
          after = substr(low, p + length(pv[i]), 1); before = p > 1 ? substr(low, p - 1, 1) : ""
          if (after ~ /[0-9a-z.]/ && after != "" || before ~ /[0-9a-z.]/ && before != "") continue
        }
        report(pk[i])
      }
      if (cfgfile && match(line, /^[[:space:]]*-?[[:space:]]*password:[[:space:]]*[^[:space:]#]/)) {
        v = line; sub(/^[^:]*password:[[:space:]]*/, "", v); gsub(/["'\'']|[[:space:]]*#.*$/, "", v)
        if (v !~ /^(change-me|changeme|null|~|<.*>|\$\{.*\}|\*+)$/ && v != "") report("password: <hidden>")
      }
      s = line
      while (match(s, /[a-z0-9+]+:\/\/[^\/[:space:]:@"'\''`]+:[^@[:space:]\/"'\''`]+@/)) {
        cred = substr(s, RSTART, RLENGTH); sub(/^[^:]+:\/\//, "", cred); sub(/@$/, "", cred)
        if (cred !~ ph && cred !~ /[$\{\}]/) report("URL with an embedded login (user:<hidden>@)")
        s = substr(s, RSTART + RLENGTH)
      }
      s = low
      while (match(s, /[a-z0-9._%+-]+@[a-z0-9-]+(\.[a-z0-9-]+)*\.[a-z][a-z]+/)) {
        em = substr(s, RSTART, RLENGTH); s = substr(s, RSTART + RLENGTH)
        if (em !~ /@(example\.(com|org|net)|anthropic\.com|users\.noreply\.github\.com)$/ && em !~ /^(no-?reply|someone|user|you|me)@/)
          report("an email address (use someone@example.com)")
      }
    }
    END { exit bad }'
}
as_diff() { printf '+++ b/%s\n@@ -0,0 +1 @@\n' "$1"; sed 's/^/+/'; }   # plain text -> scannable diff

problems=0
check_names() {  # stdin: file names; $1: label
  local bad; bad=$(grep -E "$FORBIDDEN" || true)
  if [ -n "$bad" ]; then printf '%s\n' "$bad" | sed "s/^/  $1  forbidden file: /"; problems=1; fi
}

case "${1:-}" in
  --staged)
    check_names "staged" < <(git diff --cached --name-only --diff-filter=ACMR)
    git diff --cached -U0 --no-color --diff-filter=ACMR | scan_diff "staged" || problems=1 ;;
  --message)
    grep -v '^#' "$2" | as_diff "(commit message)" | scan_diff "new commit" || problems=1 ;;
  *)
    for c in $(git rev-list "$@"); do
      short=$(git rev-parse --short "$c")
      check_names "$short" < <(git diff-tree -r --root --no-commit-id --name-only --diff-filter=ACMR "$c")
      git show --format= -U0 --no-color --diff-filter=ACMR "$c" | scan_diff "$short" || problems=1
      git log -1 --format=%B "$c" | as_diff "(commit message)" | scan_diff "$short" || problems=1
    done ;;
esac

if [ "$problems" != 0 ]; then
  echo "✋ Blocked: the above would publish credentials, private config or personal details." >&2
  echo "   Replace them with sample data (192.168.1.50, user:pass, someone@example.com) or remove the file," >&2
  echo "   then try again (for a pushed commit: amend or rebase it)." >&2
  exit 1
fi
