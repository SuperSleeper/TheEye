#!/usr/bin/env bash
# Refuse pushes whose new commits contain credentials or private config (see check-secrets).
# stdin: <local ref> <local sha> <remote ref> <remote sha> per ref being pushed.
set -euo pipefail
zero=0000000000000000000000000000000000000000
remote="$1"
status=0
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$zero" ] && continue                       # deleting a branch
  if [ "$rsha" = "$zero" ] || ! git cat-file -e "$rsha" 2>/dev/null; then
    range=("$lsha" --not "--remotes=$remote")              # new branch / rewritten history: all not on the remote
  else
    range=("$rsha..$lsha")
  fi
  "$(dirname "$0")/check-secrets" "${range[@]}" || status=1
done
exit $status
